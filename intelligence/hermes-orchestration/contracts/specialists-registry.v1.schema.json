{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jivo.internal/contracts/specialists-registry.v1.schema.json",
  "title": "JIVO specialists registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_schema", "specialists"],
  "properties": {
    "registry_schema": {"const": "jivo.specialists/v1"},
    "specialists": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability_card"}
    }
  },
  "$defs": {
    "capability_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "domain", "owns", "source_ids", "cli", "freshness_sla", "skill", "output_schema", "writes", "lifecycle", "readiness"],
      "properties": {
        "schema": {"const": "jivo.capability-card/v1"},
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "domain": {"type": "string", "minLength": 1},
        "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "cli": {"type": ["string", "null"]},
        "freshness_sla": {"type": ["string", "null"]},
        "skill": {"type": ["string", "null"]},
        "output_schema": {"const": "jivo.evidence-packet/v1"},
        "writes": {"const": false},
        "lifecycle": {"enum": ["planned", "draft", "validated", "governed", "blocked"]},
        "readiness": {"enum": ["enabled", "planned", "blocked"]}
      }
    }
  }
}
