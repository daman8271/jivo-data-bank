{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jivo.internal/contracts/authority-registry.v1.schema.json",
  "title": "JIVO authority registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_schema", "authorities"],
  "properties": {
    "registry_schema": {"const": "jivo.authority/v1"},
    "authorities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["authority_id", "process", "field_scope", "time_scope", "source_ids", "lifecycle", "proxy"],
        "properties": {
          "authority_id": {"type": "string", "pattern": "^auth-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
          "process": {"type": "string", "minLength": 1},
          "field_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "time_scope": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "lifecycle": {"enum": ["planned", "draft", "validated", "governed", "blocked"]},
          "proxy": {"type": "boolean"}
        }
      }
    }
  }
}
